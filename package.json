{
  "name": "dominium-space",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "node scripts/seo/generate-sitemap.mjs && node ./node_modules/typescript/bin/tsc -b && node ./node_modules/vite/bin/vite.js build && node scripts/seo/generate-prerender-html.mjs",
    "build:showcase": "cd .tmp_instaauto_demo_src_v2 && npm run build && cp dist/index.html ../public/showcase/instaauto-demo/index.html && rm -rf ../public/showcase/instaauto-demo/assets && cp -R dist/assets ../public/showcase/instaauto-demo/assets && rm -rf ../public/showcase/instaauto-demo/images && cp -R dist/images ../public/showcase/instaauto-demo/images",
    "build:seo:check": "node scripts/seo/check-seo-build.mjs",
    "lint": "node ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node ./node_modules/eslint/bin/eslint.js . --fix",
    "test": "node ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node ./node_modules/vitest/vitest.mjs",
    "test:php": "bash scripts/tests/php-endpoints-smoke.sh",
    "test:ci": "npm run test && npm run test:php",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "lh:mobile": "node scripts/lighthouse/run-lighthouse.mjs mobile",
    "lh:desktop": "node scripts/lighthouse/run-lighthouse.mjs desktop",
    "format": "node ./node_modules/prettier/bin/prettier.cjs . --write",
    "format:check": "node ./node_modules/prettier/bin/prettier.cjs . --check"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.3.0",
    "@types/react-textfit": "^1.1.4",
    "libphonenumber-js": "^1.12.22",
    "matter-js": "^0.20.0",
    "papaparse": "^5.5.3",
    "react": "^19.1.1",
    "react-compiler-runtime": "^19.1.0-rc.3",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^3.0.0",
    "react-hook-form": "^7.71.2",
    "react-router-dom": "^7.9.1",
    "three": "^0.180.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/matter-js": "^0.19.7",
    "@types/papaparse": "^5.5.0",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/browser-playwright": "^4.0.6",
    "@vitest/coverage-v8": "^4.0.6",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "playwright": "^1.56.1",
    "prettier": "^3.6.2",
    "sass": "^1.93.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^4.0.6"
  }
}
