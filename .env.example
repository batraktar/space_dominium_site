# Site URL
VITE_SITE_URL=https://space.dominium.com.ua

# Google Sheets (CSV / pubhtml URLs)
VITE_FAQ_HOME_SHEET_URL=
VITE_FAQ_SMM_SHEET_URL=
VITE_FAQ_DESIGN_SHEET_URL=
VITE_FAQ_WEB_SHEET_URL=
VITE_DESIGN_CARDS_SHEET_URL=

# Analytics / Tracking
VITE_GA4_MEASUREMENT_ID=
VITE_GOOGLE_ADS_ID=
VITE_GOOGLE_ADS_CONVERSION_LABEL=
VITE_GTM_ID=
VITE_GSC_VERIFICATION=

# Local development only (frontend direct fallback in DEV)
# Do not use these in production builds.
VITE_TELEGRAM_BOT_TOKEN=
# Supports multiple chat IDs separated by commas.
VITE_TELEGRAM_CHAT_ID=

# Production/server side (set in cPanel Environment Variables)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# THANKS_GATE_SECRET=
# Optional: comma-separated allowlist for contact form origin check
# CONTACT_ALLOWED_ORIGINS=https://space.dominium.com.ua,https://www.space.dominium.com.ua
